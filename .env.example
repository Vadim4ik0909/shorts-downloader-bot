# Токени бота (вказувати свої)
BOT_TOKEN=your_shorts_bot_token_here
ANIME_BOT_TOKEN=your_anime_bot_token_here

# Ключі Telegram MTProto API (отримувати на my.telegram.org)
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Налаштування тегів і папок
ANIME_DOWNLOAD_DIR=~/Downloads/(Завантажене аніме)
ANIME_TAG_NAME=На черзі глянути
ANIME_TAG_COLOR=2

# Дозволені User ID Telegram (через кому). Якщо порожньо — дозволено вам
# ALLOWED_USERS=123456789
