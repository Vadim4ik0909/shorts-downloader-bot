# Токен вашого Telegram-бота від @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Максимальний розмір відео для відправки через стандартний Telegram Bot API (в мегабайтах)
MAX_FILE_SIZE_MB=50

# Необов'язково: шлях до cookies.txt для доступу до приватних чи обмежених відео
# COOKIES_FILE=cookies.txt
